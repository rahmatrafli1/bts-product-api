{
  "openapi": "3.0.0",
  "info": {
    "title": "BTS Product API",
    "version": "1.0.0",
    "description": "REST API Product Management dengan JWT Authentication"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ProductInput": {
        "type": "object",
        "required": ["title", "price", "category", "images"],
        "properties": {
          "title": {
            "type": "string",
            "example": "T-Shirt Premium"
          },
          "price": {
            "type": "number",
            "example": 120000
          },
          "description": {
            "type": "string",
            "example": "Kaos katun premium"
          },
          "category": {
            "type": "string",
            "example": "Clothes"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["https://example.com/tshirt.jpg"]
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "password_confirmation"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "raf"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "password_confirmation": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login untuk mendapatkan JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "raf"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil, response berisi authentication_token"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Menampilkan semua produk",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar produk"
          },
          "401": {
            "description": "Token tidak ada atau tidak valid"
          }
        }
      },
      "post": {
        "summary": "Menambah produk",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produk berhasil dibuat"
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "summary": "Menampilkan detail produk",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail produk"
          }
        }
      },
      "put": {
        "summary": "Mengubah produk",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produk berhasil diubah"
          }
        }
      },
      "delete": {
        "summary": "Menghapus produk",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produk berhasil dihapus"
          }
        }
      }
    }
  }
}
